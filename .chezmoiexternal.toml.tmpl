[".config/opencode"]
    type = "git-repo"
    url = "git@github.com:xnoto/opencode-config.git"
    pull.args = ["--ff-only", "--autostash"]

[".config/mcp-gateway"]
    type = "git-repo"
    url = "git@github.com:xnoto/mcp-gateway.git"
    pull.args = ["--ff-only", "--autostash"]

[".config/opencode-llama"]
    type = "git-repo"
    url = "git@github.com:xnoto/opencode-llama-config.git"
    pull.args = ["--ff-only", "--autostash"]

[".codex"]
    type = "git-repo"
    url = "git@github.com:xnoto/codex-config.git"
    pull.args = ["--ff-only", "--autostash"]

[".config/alacritty/alacritty-theme-linux-vconsole"]
    type = "git-repo"
    url = "git@github.com:xnoto/alacritty-theme-linux-vconsole.git"
    pull.args = ["--ff-only", "--autostash"]

[".config/alacritty/themes"]
    type = "git-repo"
    url = "https://github.com/alacritty/alacritty-theme"
    pull.args = ["--ff-only", "--autostash"]

# Update this commit only after reviewing xnoto/claude-config; the archive is
# the canonical producer for the rendered ~/.claude target. When bumping the
# pinned commit, recompute the checksum from the new codeload archive bytes.
[".claude"]
    type = "archive"
    url = "https://codeload.github.com/xnoto/claude-config/tar.gz/a5266f5c2b3ab7a3f57d1b4ad87ba881a9706943"
    checksum.sha256 = "73bbbaebdb82996698fa9223352d4479ca997db8c4d9422927363bffe9e1d24d"
    exact = true
    stripComponents = 1
    exclude = ["**/LICENSE"]

{{- if eq .chezmoi.os "linux" }}

# tpm (Tmux Plugin Manager) — on macOS this is provided by Homebrew (`brew install tpm`).
[".tmux/plugins/tpm"]
    type = "git-repo"
    url = "https://github.com/tmux-plugins/tpm"
    pull.args = ["--ff-only", "--autostash"]
{{- end }}
