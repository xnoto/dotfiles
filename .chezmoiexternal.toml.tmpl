# xnoto/claude-config is the canonical producer for the rendered ~/.claude
# target. This mapping tracks its main branch: push there and the next
# `make install` deploys it. No commit pin and no checksum, matching how the
# alacritty-theme and tpm externals track their upstreams.
#
# chezmoi caches archive externals, and with `refreshPeriod` unset it never
# re-downloads unless forced. The Makefile's build and install targets already
# pass `-R`; `refreshPeriod` bounds the staleness of a bare `chezmoi apply` or
# `chezmoi update` that does not.
#
# `exact` must stay off. Claude Code owns ~/.claude and keeps unmanaged runtime
# state there (projects/, sessions/, plugins/, history.jsonl, backups/,
# file-history/, shell-snapshots/). An exact directory makes `chezmoi apply`
# remove every entry not present in this archive, which would destroy all of it.
# This mapping contributes files to ~/.claude; it does not own it.
[".claude"]
    type = "archive"
    url = "https://codeload.github.com/xnoto/claude-config/tar.gz/refs/heads/main"
    refreshPeriod = "168h"
    stripComponents = 1
    # Repository tooling; it has no meaning inside ~/.claude.
    exclude = [
        "**/LICENSE",
        "**/README.md",
        "**/.gitignore",
        "**/.pre-commit-config.yaml",
        "**/.secrets.baseline",
    ]

{{- if eq .chezmoi.os "linux" }}

# tpm (Tmux Plugin Manager) — on macOS this is provided by Homebrew (`brew install tpm`).
[".tmux/plugins/tpm"]
    type = "git-repo"
    url = "https://github.com/tmux-plugins/tpm"
    pull.args = ["--ff-only", "--autostash"]
{{- end }}
