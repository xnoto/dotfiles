# shellcheck shell=sh
path_prepend() {
  case ":${PATH}:" in
    *":$1:"*) ;;
    *) PATH="$1:${PATH}" ;;
  esac
}

path_prepend "${HOME}/.local/bin"

if [ -d "${HOME}/.kimi-code/bin" ]; then
  path_prepend "${HOME}/.kimi-code/bin"
fi

if [ -d "${HOME}/.bun/bin" ]; then
  export BUN_INSTALL="${HOME}/.bun"
  path_prepend "${HOME}/.bun/bin"
fi

path_prepend "${HOME}/go/bin"
export PATH

export NODE_OPTIONS='--max-old-space-size=6144'
export EDITOR=vim
export VISUAL=vim

{{ $secrets := fromYaml (include "encrypted_secrets.yaml.age" | decrypt) -}}
unset GITHUB_TOKEN GITHUB_MCP_TOKEN GHORG_GITHUB_TOKEN GRAFANA_TOKEN PARALLEL_API_KEY ARGOCD_STAGING_TOKEN ARGOCD_PROD_TOKEN ARGOCD_MAKEITWORK_TOKEN APIFY_TOKEN OPENCODE_WEB_PASSWORD CF_ACCESS_CLIENT_ID CF_ACCESS_CLIENT_SECRET
{{ with index $secrets "github_mcp_token" -}}
# Consumed by ~/.config/mcp-gateway/bin/github after sourcing this file.
# shellcheck disable=SC2034
GITHUB_MCP_TOKEN={{ . | quote }}
GHORG_GITHUB_TOKEN={{ . | quote }}
{{ end -}}
export GHORG_CLONE_PROTOCOL="ssh"
export GHORG_ABSOLUTE_PATH_TO_CLONE_TO="${HOME}/git"
{{ with index $secrets "grafana_mcp_token" -}}
# Consumed by ~/.config/mcp-gateway/bin/grafana after sourcing this file.
# shellcheck disable=SC2034
GRAFANA_TOKEN={{ . | quote }}
{{ end -}}
{{ with index $secrets "parallel_mcp_api_key" -}}
# Consumed by ~/.config/mcp-gateway/bin/parallel-search after sourcing this file.
# shellcheck disable=SC2034
PARALLEL_API_KEY={{ . | quote }}
{{ end -}}
{{ with index $secrets "argocd_staging_mcp_token" -}}
# Consumed by ~/.config/mcp-gateway/bin/argocd after sourcing this file.
# shellcheck disable=SC2034
ARGOCD_STAGING_TOKEN={{ . | quote }}
{{ end -}}
{{ with index $secrets "argocd_prod_mcp_token" -}}
# Consumed by ~/.config/mcp-gateway/bin/argocd after sourcing this file.
# shellcheck disable=SC2034
ARGOCD_PROD_TOKEN={{ . | quote }}
{{ end -}}
{{ with index $secrets "argocd_makeitwork_mcp_token" -}}
# Consumed by ~/.config/mcp-gateway/bin/argocd after sourcing this file.
# shellcheck disable=SC2034
ARGOCD_MAKEITWORK_TOKEN={{ . | quote }}
{{ end -}}
{{ with index $secrets "apify_mcp_token" -}}
# Consumed by ~/.config/mcp-gateway/bin/apify after sourcing this file.
# shellcheck disable=SC2034
APIFY_TOKEN={{ . | quote }}
{{ end -}}
{{ with index $secrets "opencode_server_password" -}}
# Scoped to the opencode-web and opencode-list wrappers so the credential is
# not exported to child processes.
OPENCODE_WEB_PASSWORD={{ . | quote }}
{{ end -}}
{{ with index $secrets "cf_access_client_id" -}}
# Cloudflare Access service token for mcp.makeitwork.cloud; exported so any
# agent CLI (opencode, claude, codex) can read it without wrapper curation.
export CF_ACCESS_CLIENT_ID={{ . | quote }}
{{ end -}}
{{ with index $secrets "cf_access_client_secret" -}}
export CF_ACCESS_CLIENT_SECRET={{ . | quote }}
{{ end -}}

unalias gh ghorg opencode opencode-web opencode-list opencode-list-sessions 2>/dev/null || true
ghorg() {
  : "${GHORG_GITHUB_TOKEN:?ghorg requires the github_mcp_token secret}"
  GHORG_GITHUB_TOKEN="${GHORG_GITHUB_TOKEN}" command ghorg "$@"
}
opencode_web() {
  if [ -z "${OPENCODE_WEB_PASSWORD:-}" ]; then
    printf '%s\n' 'opencode-web: missing opencode_server_password' >&2
    return 1
  fi

  # OpenCode v2 removed `attach --dir`; the client sends its local working
  # directory as the remote project.
  OPENCODE_PASSWORD="${OPENCODE_WEB_PASSWORD}" \
  command opencode --server "https://opencode.makeitwork.cloud" "$@"
}
opencode_list() (
  # Subshell body: isolates variables and keeps xtrace from disclosing the
  # credential without changing the caller's trace state.
  set +x

  if [ -z "${OPENCODE_WEB_PASSWORD:-}" ]; then
    printf '%s\n' 'opencode-list: missing opencode_server_password' >&2
    exit 1
  fi
  if [ "$#" -ne 0 ]; then
    printf '%s\n' 'opencode-list: arguments are not supported' >&2
    exit 2
  fi

  # Escape curl-config metacharacters in the credential.
  password="$(printf '%s\n' "${OPENCODE_WEB_PASSWORD}" \
    | command sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
  unset OPENCODE_WEB_PASSWORD

  # The v2 API pages sessions as {"data": [...], "cursor": {"next": ...}}.
  # Without jq the cursor cannot be followed, so print the first page raw.
  url="https://opencode.makeitwork.cloud/api/session?limit=200"
  response=""
  while :; do
    # -q disables curlrc so user configuration cannot log or redirect the
    # credential; credentials travel through a stdin config, never argv.
    if ! page="$(printf 'user = "opencode:%s"\n' "${password}" \
      | command curl -q -fsS --config - "${url}")"; then
      printf '%s\n' 'opencode-list: failed to query https://opencode.makeitwork.cloud' >&2
      exit 1
    fi
    if ! command -v jq >/dev/null 2>&1; then
      printf '%s\n' "${page}"
      exit 0
    fi
    response="${response}${page}
"
    cursor="$(printf '%s\n' "${page}" \
      | command jq -r 'if (.data | length) > 0 then .cursor.next // empty else empty end | @uri')"
    [ -n "${cursor}" ] || break
    url="https://opencode.makeitwork.cloud/api/session?limit=200&cursor=${cursor}"
  done
  unset password

  printf '%s' "${response}" | command jq -rs '
      [.[].data[] | select(.parentID == null)] |
      sort_by(.time.updated) | reverse | .[] |
      [(.id | gsub("[\\p{Cc}\\p{Cf}]"; "")),
       (.time.updated / 1000 | todate),
       (.title | gsub("[\\p{Cc}\\p{Cf}]"; ""))] | @tsv'
)
# Define the hyphenated interactive commands only in shells that support them.
# POSIX sh gateway wrappers retain the portable underscore functions.
if (eval 'opencode-web() { :; }') 2>/dev/null; then
  # shellcheck disable=SC2016 # $@ expands when eval runs.
  eval 'opencode-web() { opencode_web "$@"; }'
  # shellcheck disable=SC2016 # $@ expands when eval runs.
  eval 'opencode-list-sessions() { opencode_list "$@"; }'
  # shellcheck disable=SC2016 # $@ expands when eval runs.
  eval 'opencode-list() { opencode_list "$@"; }'
fi

unalias claude codex 2>/dev/null || true
claude() {
  command claude \
    --mcp-config "${HOME}/.claude/mcp.json" \
    --strict-mcp-config \
    "$@"
}
