set -g set-titles on
set -g set-titles-string "#W"
set-window-option -g mouse on
set-window-option -g mode-keys vi
set -g extended-keys on
# For Kimi,
set -g extended-keys-format csi-u

# List of plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
{{- if eq .chezmoi.os "darwin" }}
set -g @plugin 'litridl/tmux-gruvbox-bundle'
set -g @gruvbox-theme 'gruvbox-original-dark'
set -g @gruvbox-statusline-theme 'powerline-minimal'
{{- else }}
set -g @plugin 'dracula/tmux'
{{- end }}

# Clipboard integration
set -g set-clipboard on
{{- if eq .chezmoi.os "darwin" }}
bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "pbcopy"
bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "pbcopy"
{{- else }}
bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "xclip -selection clipboard"
bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "xclip -selection clipboard"
{{- end }}

# Activate tpm
{{- if eq .chezmoi.os "darwin" }}
# macOS: tpm installed via Homebrew (`brew install tpm`)
run -b '/opt/homebrew/opt/tpm/share/tpm/tpm'
{{- else }}
# Linux: tpm cloned to ~/.tmux/plugins/tpm via .chezmoiexternal.toml
run -b '~/.tmux/plugins/tpm/tpm'
{{- end }}
