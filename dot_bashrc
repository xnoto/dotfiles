# shellcheck shell=bash
# Managed by chezmoi. Interactive bash shells source this file;
# ~/.bash_profile chains login shells to it.

# Skip non-interactive shells, such as remote scp or rsync invocations.
case $- in
  *i*) ;;
  *) return ;;
esac

# Restore Fedora's system-wide interactive setup, including the default prompt.
# This belongs in Bash's entrypoint rather than ~/.shellenv, which is POSIX-sourced.
if [ -r /etc/bashrc ]; then
  # shellcheck source=/dev/null
  . /etc/bashrc
fi

for entry in "${HOME}"/.bashrc.d/*; do
  [ -r "${entry}" ] || continue
  # shellcheck source=/dev/null
  . "${entry}"
done
